#!/bin/sh

#
# Gradle start up script for POSIX generated for Folia Android (Capacitor).
# Uses gradle/wrapper/gradle-wrapper.jar and gradle/wrapper/gradle-wrapper.properties.
#

set -e

APP_HOME=$( cd "${0%/*}" && pwd -P ) || exit
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
WRAPPER_PROPS="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"

BOOTSTRAP_DIRECT=0
if [ "${1:-}" = "--bootstrap-exec" ] ; then
    BOOTSTRAP_DIRECT=1
    shift
fi

if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
        exit 1
    fi
else
    JAVACMD=java
    command -v java >/dev/null 2>&1 || {
        echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
        exit 1
    }
fi

if [ "$BOOTSTRAP_DIRECT" -eq 0 ] && [ -f "$WRAPPER_JAR" ] ; then
    cd "$APP_HOME"
    exec "$JAVACMD" -Xmx64m -Xms64m \
        "-Dorg.gradle.appname=gradlew" \
        -classpath "$WRAPPER_JAR" \
        org.gradle.wrapper.GradleWrapperMain "$@"
fi

# Extract distributionUrl from gradle-wrapper.properties
DIST_URL=$(grep '^distributionUrl=' "$WRAPPER_PROPS" | sed 's/^distributionUrl=//; s/\\:/:/g' | tr -d '\r')
if [ -z "$DIST_URL" ] ; then
    DIST_URL="https://services.gradle.org/distributions/gradle-8.14.3-bin.zip"
fi

GRADLE_VERSION=$(basename "$DIST_URL" | sed -E 's/^gradle-([0-9.]+)-(all|bin)\.zip$/\1/')

# If a matching or pre-configured gradle binary is already on PATH (e.g. via gradle/actions/setup-gradle), use it
if command -v gradle >/dev/null 2>&1 && gradle --version 2>/dev/null | grep -q "Gradle ${GRADLE_VERSION}" ; then
    exec gradle -p "$APP_HOME" "$@"
fi

CACHE_ROOT="${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/dists/gradle-${GRADLE_VERSION}-bootstrap"
GRADLE_BIN="$CACHE_ROOT/gradle-${GRADLE_VERSION}/bin/gradle"

if [ ! -x "$GRADLE_BIN" ] ; then
    echo "[gradlew] Bootstrapping Gradle ${GRADLE_VERSION} from ${DIST_URL}..." >&2
    mkdir -p "$CACHE_ROOT"
    TMP_ZIP="$CACHE_ROOT/gradle-${GRADLE_VERSION}.zip"
    if command -v curl >/dev/null 2>&1 ; then
        curl -fsSL "$DIST_URL" -o "$TMP_ZIP"
    elif command -v wget >/dev/null 2>&1 ; then
        wget -q "$DIST_URL" -O "$TMP_ZIP"
    else
        echo "ERROR: Neither curl nor wget is available to download Gradle from $DIST_URL" >&2
        exit 1
    fi
    unzip -q -o "$TMP_ZIP" -d "$CACHE_ROOT"
    rm -f "$TMP_ZIP"
    chmod +x "$GRADLE_BIN"
fi

exec "$GRADLE_BIN" -p "$APP_HOME" "$@"
